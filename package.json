{
  "name": "@polivor/sdk",
  "version": "0.1.0",
  "description": "TypeScript client for the Polivor API, generated from the OpenAPI file.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "generate": "openapi-typescript openapi/polivor.yaml -o src/schema.d.ts",
    "build": "npm run generate && tsc -p tsconfig.json && cp src/schema.d.ts dist/schema.d.ts",
    "test": "npm run build && node --test --experimental-test-coverage --test-coverage-include=dist/index.js --test-coverage-lines=90 --test-coverage-functions=90 --test-coverage-branches=80 test/*.test.mjs && ./scripts/check-package.sh"
  },
  "dependencies": {
    "jose": "6.2.12",
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  },
  "license": "Apache-2.0",
  "homepage": "https://polivor.com/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Polivor/polivor-sdk-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/Polivor/polivor-sdk-typescript/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
